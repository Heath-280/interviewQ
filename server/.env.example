# ---------------------------------------------------------------------------
# InterviewIQ backend configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/interviewiq?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/interviewiq

# JWT secrets - generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# Cookie options
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ---------------------------------------------------------------------------
# AI / LLM provider (OpenAI-compatible Chat Completions API)
# Works with OpenAI, OpenRouter, Groq, Together, Azure OpenAI, local Ollama, etc.
# The API key is used ONLY on the server and is never sent to the browser.
# ---------------------------------------------------------------------------
# Leave AI_API_KEY empty to run in "unconfigured" mode: AI routes return a clear
# 503 configuration message instead of pretending to work.
AI_API_KEY=
# Base URL WITHOUT the trailing /chat/completions
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000

# Safe development mode. When true AND no AI_API_KEY is set, the server returns
# clearly-labelled deterministic TEMPLATE content (never presented as real AI)
# so the full UI/flow can be exercised offline. Always false in production.
AI_DEV_MODE=true

# Seed admin account (used by `npm run seed`)
ADMIN_NAME=InterviewIQ Admin
ADMIN_EMAIL=admin@interviewiq.dev
ADMIN_PASSWORD=ChangeMe123!
